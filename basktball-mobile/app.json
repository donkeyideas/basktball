{
  "expo": {
    "name": "BASKTBALL",
    "slug": "basktball",
    "owner": "donkeyideas",
    "version": "1.3.18",
    "orientation": "portrait",
    "icon": "./assets/images/logo-icon.png",
    "scheme": "basktball",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/logo-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.basktball.app",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSPhotoLibraryUsageDescription": "BASKTBALL needs access to your photo library so you can select and upload images to include in your posts and takes.",
        "NSSpeechRecognitionUsageDescription": "BASKTBALL uses speech recognition so you can dictate your takes and posts using voice input.",
        "NSMicrophoneUsageDescription": "BASKTBALL needs microphone access for voice-to-text input when composing takes.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "buildNumber": "45"
    },
    "android": {
      "package": "com.basktball.app",
      "versionCode": 50,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#0D0D0D"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF6B35"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withFirebaseNonModularHeaders",
      "./plugins/withSwiftConcurrencyMinimal",
      "./plugins/withRealpathFix",
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "BASKTBALL needs access to your photo library so you can select and upload images to include in your posts and takes."
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://www.basktball.com/api",
      "router": {},
      "eas": {
        "projectId": "f155a87c-d074-43c1-ac99-7a8a10c64c81"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/f155a87c-d074-43c1-ac99-7a8a10c64c81"
    }
  }
}
