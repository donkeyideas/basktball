// Basktball Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum League {
  NBA
  WNBA
  NCAAM
  NCAAW
  EURO
  INTL
}

enum GameStatus {
  SCHEDULED
  LIVE
  FINAL
  POSTPONED
  CANCELLED
}

enum InsightType {
  GAME_RECAP
  GAME_PREVIEW
  PLAYER_ANALYSIS
  BETTING
  FANTASY
  TRENDING
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum SocialPlatform {
  TWITTER
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

// =============================================================================
// CORE MODELS
// =============================================================================

model Team {
  id           String   @id
  name         String
  abbreviation String
  city         String?
  logoUrl      String?
  primaryColor String?
  league       League
  conference   String?
  division     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  players   Player[]
  homeGames Game[]      @relation("HomeTeam")
  awayGames Game[]      @relation("AwayTeam")
  teamStats TeamStat[]

  @@index([league])
  @@index([abbreviation])
}

model Player {
  id          String   @id
  name        String
  firstName   String?
  lastName    String?
  teamId      String?
  position    String?
  jerseyNum   Int?
  height      String?
  weight      Int?
  birthDate   DateTime?
  college     String?
  country     String?
  headshotUrl String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  team     Team?        @relation(fields: [teamId], references: [id])
  stats    PlayerStat[]
  insights AiInsight[]

  @@index([teamId])
  @@index([name])
}

model Game {
  id            String     @id
  homeTeamId    String
  awayTeamId    String
  gameDate      DateTime
  status        GameStatus
  homeScore     Int?
  awayScore     Int?
  quarter       String?
  clock         String?
  arena         String?
  attendance    Int?
  league        League
  season        String?
  isPlayoffs    Boolean    @default(false)
  broadcastInfo String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  homeTeam    Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  playerStats PlayerStat[]
  teamStats   TeamStat[]
  insights    AiInsight[]
  chatRoom    ChatRoom?
  predictions          Prediction[]
  gameNotificationLogs GameNotificationLog[]

  @@index([gameDate])
  @@index([status])
  @@index([league])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

// =============================================================================
// STATS MODELS
// =============================================================================

model PlayerStat {
  id        String   @id @default(cuid())
  playerId  String
  gameId    String
  minutes   Int      @default(0)
  points    Int      @default(0)
  rebounds  Int      @default(0)
  offReb    Int      @default(0)
  defReb    Int      @default(0)
  assists   Int      @default(0)
  steals    Int      @default(0)
  blocks    Int      @default(0)
  turnovers Int      @default(0)
  fouls     Int      @default(0)
  fgm       Int      @default(0)
  fga       Int      @default(0)
  tpm       Int      @default(0)
  tpa       Int      @default(0)
  ftm       Int      @default(0)
  fta       Int      @default(0)
  plusMinus Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([playerId, gameId])
  @@index([gameId])
  @@index([playerId])
}

model TeamStat {
  id                String   @id @default(cuid())
  teamId            String
  gameId            String
  points            Int      @default(0)
  rebounds          Int      @default(0)
  assists           Int      @default(0)
  steals            Int      @default(0)
  blocks            Int      @default(0)
  turnovers         Int      @default(0)
  fgm               Int      @default(0)
  fga               Int      @default(0)
  tpm               Int      @default(0)
  tpa               Int      @default(0)
  ftm               Int      @default(0)
  fta               Int      @default(0)
  offensiveRating   Float?
  defensiveRating   Float?
  pace              Float?
  fastBreakPoints   Int      @default(0)
  pointsInPaint     Int      @default(0)
  secondChancePoints Int     @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([teamId, gameId])
  @@index([gameId])
  @@index([teamId])
}

// =============================================================================
// AI CONTENT
// =============================================================================

model AiInsight {
  id          String      @id @default(cuid())
  type        InsightType
  title       String?
  content     String      @db.Text
  summary     String?
  playerId    String?
  gameId      String?
  confidence  Float?
  tokenUsage  Int?
  approved    Boolean     @default(true)
  published   Boolean     @default(true)
  metadata    Json?
  generatedAt DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  game   Game?   @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([gameId])
  @@index([playerId])
  @@index([generatedAt])
  @@index([approved])
}

// =============================================================================
// ADMIN & JOBS
// =============================================================================

model JobRun {
  id           String    @id @default(cuid())
  jobName      String
  status       JobStatus
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  duration     Int?
  error        String?   @db.Text
  itemsProcessed Int     @default(0)
  metadata     Json?

  @@index([jobName])
  @@index([status])
  @@index([startedAt])
}

model ApiLog {
  id           String   @id @default(cuid())
  endpoint     String
  method       String
  statusCode   Int
  responseTime Int
  error        String?
  timestamp    DateTime @default(now())

  @@index([endpoint])
  @@index([timestamp])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("string")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiTracker {
  id               String   @id @default(cuid())
  provider         String
  endpoint         String
  method           String   @default("GET")
  statusCode       Int      @default(200)
  responseTime     Int      @default(0)
  tokensUsed       Int?
  promptTokens     Int?
  completionTokens Int?
  estimatedCost    Float    @default(0)
  cached           Boolean  @default(false)
  callerRoute      String?
  error            String?  @db.Text
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([provider])
  @@index([createdAt])
  @@index([cached])
}

// =============================================================================
// SOCIAL MEDIA
// =============================================================================

model SocialMediaPost {
  id           String           @id @default(cuid())
  platform     SocialPlatform
  content      String           @db.Text
  imagePrompt  String?
  hashtags     String[]
  status       SocialPostStatus @default(DRAFT)
  tone         String?
  topic        String?
  scheduledAt  DateTime?
  publishedAt  DateTime?
  externalId   String?
  errorMessage String?          @db.Text
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

// =============================================================================
// CONTENT MANAGEMENT
// =============================================================================

model Article {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  content     String          @db.Text
  excerpt     String?
  metaTitle   String?
  metaDesc    String?
  ogImage     String?
  keywords    String[]
  category    ArticleCategory
  status      ContentStatus   @default(DRAFT)
  authorName  String?
  publishedAt DateTime?
  viewCount   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([publishedAt])
}

enum ArticleCategory {
  NEWS
  ANALYSIS
  FANTASY
  BETTING
  RECAP
  TRENDING
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// =============================================================================
// ADVERTISEMENT SYSTEM
// =============================================================================

model AdCampaign {
  id          String       @id @default(cuid())
  name        String
  status      AdStatus     @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  totalSpend  Float        @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  placements  AdPlacement[]

  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model AdPlacement {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  slot        AdSlot
  imageUrl    String?
  htmlContent String?    @db.Text
  linkUrl     String?
  altText     String?
  targeting   Json?
  weight      Int        @default(1)
  impressions Int        @default(0)
  clicks      Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([campaignId])
  @@index([slot])
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum AdSlot {
  HEADER_BANNER
  SIDEBAR_TOP
  SIDEBAR_BOTTOM
  IN_CONTENT
  FOOTER_BANNER
  MOBILE_STICKY
  INTERSTITIAL
  LIVE_SCORES_INLINE
  PLAYER_CARD_INLINE
  TOOL_SIDEBAR
}

// =============================================================================
// DRAFT & HISTORY SYSTEM
// =============================================================================

model DraftProspect {
  id            String   @id @default(cuid())
  rank          Int
  name          String
  position      String
  school        String
  height        String
  weight        Int
  age           Int
  ppg           Float
  rpg           Float
  apg           Float
  fgPct         Float
  threePct      Float
  strengths     String[]
  weaknesses    String[]
  comparison    String?
  projectedPick String?
  draftYear     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([draftYear])
  @@index([rank])
}

model HistoricalRecord {
  id        String   @id @default(cuid())
  category  String
  record    String
  holder    String
  date      String
  details   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model SeasonHistory {
  id           String   @id @default(cuid())
  year         String   @unique
  champion     String
  mvp          String
  finalsScore  String
  topScorer    String
  topScorerPpg Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([year])
}

// =============================================================================
// USER & AUTH SYSTEM
// =============================================================================

enum UserRole {
  USER
  PREMIUM
  MODERATOR
  EDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)

  // Profile
  handle          String?    @unique
  displayName     String?
  bio             String?    @db.Text
  avatarUrl       String?
  location        String?

  // Bot configuration
  isBot           Boolean  @default(false)
  botPersonality  String?  @db.Text
  botActive       Boolean  @default(false)

  // Basketball preferences
  favoriteTeams   String[]
  favoritePlayers String[]
  favoriteTeamId  String?

  // Forum stats (denormalized)
  postCount   Int @default(0)
  threadCount Int @default(0)
  reputation  Int @default(0)

  // Moderation
  banReason   String?
  bannedUntil DateTime?
  bannedBy    String?

  // Terms acceptance
  termsAcceptedAt DateTime?

  // Timestamps
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Forum relations (legacy)
  threads           ForumThread[]
  posts             ForumPost[]
  reactions         PostReaction[]
  reports           ForumReport[]  @relation("ReportedBy")
  moderationActions ForumReport[]  @relation("ModeratedBy")
  chatMessages      ChatMessage[]

  // The Court (social feed) relations
  takes             Take[]
  takeReactions     TakeReaction[]
  reposts           Repost[]
  bookmarks         Bookmark[]
  followers         Follow[]       @relation("Following")
  following         Follow[]       @relation("Followers")
  deviceTokens      DeviceToken[]
  pollVotes         PollVote[]

  // Blocking
  blockedUsers      UserBlock[]   @relation("BlockerUser")
  blockedByUsers    UserBlock[]   @relation("BlockedUser")
  takeReports       TakeReport[]

  // Social stats (denormalized)
  takeCount      Int @default(0)
  followerCount  Int @default(0)
  followingCount Int @default(0)

  // Novel feature stats
  predictionCount    Int        @default(0)
  correctPredictions Int        @default(0)
  challengeWins      Int        @default(0)
  challengeLosses    Int        @default(0)
  streakType         StreakType  @default(NEUTRAL)
  streakCount        Int        @default(0)

  // Novel feature relations
  predictions        Prediction[]
  statChecks         StatCheck[]
  agingTakes         AgingTake[]
  challengesSent     Challenge[]      @relation("ChallengerUser")
  challengesReceived Challenge[]      @relation("ChallengedUser")
  challengesWon      Challenge[]      @relation("ChallengeWinner")
  challengeVotes     ChallengeVote[]
  notifications      Notification[]

  // Stat Lab + Take Card
  savedLabQueries    SavedLabQuery[]
  shareCards         ShareCard[]

  @@index([email])
  @@index([displayName])
  @@index([role])
  @@index([status])
}

// NextAuth: links OAuth providers to users
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth: database sessions
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth: email verification tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// FORUM SYSTEM
// =============================================================================

enum ThreadStatus {
  OPEN
  LOCKED
  ARCHIVED
}

enum ReactionType {
  LIKE
  DISLIKE
  FIRE
  BRICK
}

enum ReportReason {
  SPAM
  HARASSMENT
  OFFENSIVE
  OFF_TOPIC
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model ForumCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  // Denormalized counts
  threadCount Int @default(0)
  postCount   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threads ForumThread[]

  @@index([slug])
  @@index([sortOrder])
  @@index([isActive])
}

model ForumThread {
  id         String       @id @default(cuid())
  title      String
  slug       String       @unique
  categoryId String
  authorId   String
  status     ThreadStatus @default(OPEN)

  isPinned Boolean  @default(false)
  isHot    Boolean  @default(false)
  tags     String[]

  // Denormalized
  postCount  Int       @default(0)
  viewCount  Int       @default(0)
  lastPostAt DateTime?
  lastPostBy String?

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ForumCategory @relation(fields: [categoryId], references: [id])
  author   User          @relation(fields: [authorId], references: [id])
  posts    ForumPost[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([isPinned])
  @@index([lastPostAt])
  @@index([createdAt])
  @@index([isDeleted])
}

model ForumPost {
  id         String @id @default(cuid())
  content    String @db.Text
  threadId   String
  authorId   String
  postNumber Int

  isEdited Boolean   @default(false)
  editedAt DateTime?

  replyToId String?

  // Denormalized reaction counts
  likeCount    Int @default(0)
  dislikeCount Int @default(0)

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread    ForumThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id])
  replyTo   ForumPost?     @relation("PostReplies", fields: [replyToId], references: [id])
  replies   ForumPost[]    @relation("PostReplies")
  reactions PostReaction[]
  reports   ForumReport[]

  @@index([threadId])
  @@index([authorId])
  @@index([createdAt])
  @@index([isDeleted])
}

model PostReaction {
  id     String       @id @default(cuid())
  postId String
  userId String
  type   ReactionType

  createdAt DateTime @default(now())

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model ForumReport {
  id         String       @id @default(cuid())
  postId     String
  reporterId String
  reason     ReportReason
  details    String?      @db.Text
  status     ReportStatus @default(PENDING)

  moderatorId String?
  resolution  String?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())

  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter  User      @relation("ReportedBy", fields: [reporterId], references: [id])
  moderator User?     @relation("ModeratedBy", fields: [moderatorId], references: [id])

  @@index([postId])
  @@index([reporterId])
  @@index([status])
}

// =============================================================================
// LIVE CHAT SYSTEM
// =============================================================================

model ChatRoom {
  id           String   @id @default(cuid())
  gameId       String   @unique
  name         String
  isActive     Boolean  @default(true)
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  game     Game          @relation(fields: [gameId], references: [id])
  messages ChatMessage[]

  @@index([gameId])
  @@index([isActive])
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  authorId  String
  content   String   @db.VarChar(500)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author User     @relation(fields: [authorId], references: [id])

  @@index([roomId])
  @@index([authorId])
  @@index([createdAt])
}

// =============================================================================
// CONTACT / INBOX SYSTEM
// =============================================================================

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  adminNote String?       @db.Text
  readAt    DateTime?
  repliedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

// =============================================================================
// THE COURT - Social Feed (replaces Forum)
// =============================================================================

enum TakeReactionType {
  FIRE
  BRICK
}

enum PredictionStatus {
  PENDING
  RECEIPT
  BUST
  UNRESOLVABLE
}

enum VerificationStatus {
  VERIFIED
  FALSE
  UNVERIFIABLE
  PENDING
}

enum ChallengeStatus {
  OPEN
  ACTIVE
  VOTING
  COMPLETED
  EXPIRED
  DECLINED
}

enum StreakType {
  HOT
  COLD
  NEUTRAL
}

enum NotificationType {
  FIRE
  BRICK
  REPLY
  REPOST
  FOLLOW
  CHALLENGE
  CHALLENGE_ACCEPT
  CHALLENGE_VOTE
  CHALLENGE_RESULT
  PREDICTION_RESOLVED
  AGING_RESURFACED
  STAT_CHECK
  MENTION
  POLL_ENDED
  GAME_LIVE
  GAME_FINAL
  SYSTEM
}

model Take {
  id          String      @id @default(cuid())
  content     String      @db.VarChar(2000)
  authorId    String
  gameId      String?
  parentId    String?
  tags        String[]
  mediaUrl    String?
  mediaUrls   String[]    @default([])
  linkPreview Json?

  // Denormalized counts
  fireCount   Int         @default(0)
  brickCount  Int         @default(0)
  repostCount Int         @default(0)
  replyCount  Int         @default(0)
  viewCount   Int         @default(0)

  isDeleted   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Courtside mode
  quarter     String?
  gameClock   String?

  // Relations
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent      Take?       @relation("TakeReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies     Take[]      @relation("TakeReplies")
  reactions   TakeReaction[]
  reposts     Repost[]
  bookmarks   Bookmark[]
  poll        Poll?

  // Reports
  reports     TakeReport[]

  // Novel feature relations
  prediction  Prediction?
  statCheck   StatCheck?
  agingTake   AgingTake?
  challengerTakes  Challenge[] @relation("ChallengerTake")
  challengedTakes  Challenge[] @relation("ChallengedTake")

  @@index([authorId])
  @@index([gameId])
  @@index([parentId])
  @@index([createdAt])
  @@index([fireCount])
}

model Poll {
  id          String       @id @default(cuid())
  takeId      String       @unique
  endsAt      DateTime?
  totalVotes  Int          @default(0)
  createdAt   DateTime     @default(now())

  take        Take         @relation(fields: [takeId], references: [id], onDelete: Cascade)
  options     PollOption[]
  votes       PollVote[]
}

model PollOption {
  id         String     @id @default(cuid())
  pollId     String
  text       String     @db.VarChar(80)
  voteCount  Int        @default(0)
  position   Int        @default(0)

  poll       Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes      PollVote[]

  @@index([pollId])
}

model PollVote {
  id         String     @id @default(cuid())
  pollId     String
  optionId   String
  userId     String
  createdAt  DateTime   @default(now())

  poll       Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option     PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

model TakeReaction {
  id        String           @id @default(cuid())
  takeId    String
  userId    String
  type      TakeReactionType
  createdAt DateTime         @default(now())

  take      Take             @relation(fields: [takeId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([takeId, userId, type])
  @@index([takeId])
  @@index([userId])
}

model Repost {
  id        String   @id @default(cuid())
  takeId    String
  userId    String
  createdAt DateTime @default(now())

  take      Take     @relation(fields: [takeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([takeId, userId])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  takeId    String
  userId    String
  createdAt DateTime @default(now())

  take      Take     @relation(fields: [takeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([takeId, userId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   // "ios" | "android" | "web"
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// NOVEL COURT FEATURES
// =============================================================================

model Prediction {
  id          String           @id @default(cuid())
  takeId      String           @unique
  userId      String
  gameId      String?
  playerId    String?
  claim       String           @db.Text
  threshold   String?
  status      PredictionStatus @default(PENDING)
  result      String?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  take        Take             @relation(fields: [takeId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game?            @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([gameId])
  @@index([status])
}

model Challenge {
  id               String          @id @default(cuid())
  topic            String
  challengerId     String
  challengedId     String
  challengerTakeId String?
  challengedTakeId String?
  votesChallenger  Int             @default(0)
  votesChallenged  Int             @default(0)
  winnerId         String?
  status           ChallengeStatus @default(OPEN)
  expiresAt        DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  challenger       User            @relation("ChallengerUser", fields: [challengerId], references: [id], onDelete: Cascade)
  challenged       User            @relation("ChallengedUser", fields: [challengedId], references: [id], onDelete: Cascade)
  winner           User?           @relation("ChallengeWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  challengerTake   Take?           @relation("ChallengerTake", fields: [challengerTakeId], references: [id], onDelete: SetNull)
  challengedTake   Take?           @relation("ChallengedTake", fields: [challengedTakeId], references: [id], onDelete: SetNull)
  votes            ChallengeVote[]

  @@index([challengerId])
  @@index([challengedId])
  @@index([status])
}

model ChallengeVote {
  id          String    @id @default(cuid())
  challengeId String
  userId      String
  votedForId  String
  createdAt   DateTime  @default(now())

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
}

model StatCheck {
  id            String             @id @default(cuid())
  takeId        String             @unique
  userId        String
  claims        Json
  overallStatus VerificationStatus @default(PENDING)
  aiResponse    String?            @db.Text
  checkedAt     DateTime?
  createdAt     DateTime           @default(now())

  take          Take               @relation(fields: [takeId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([overallStatus])
}

model AgingTake {
  id           String   @id @default(cuid())
  takeId       String   @unique
  userId       String
  revisitDate  DateTime
  reason       String?
  status       String   @default("AGING") // AGING | AGED | EXPIRED
  resurfacedAt DateTime?
  createdAt    DateTime @default(now())

  take         Take     @relation(fields: [takeId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revisitDate])
  @@index([status])
}

// =============================================================================
// NOTIFICATION SYSTEM
// =============================================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      Json?
  read      Boolean          @default(false)
  pushed    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// =============================================================================
// USER SAFETY (Block & Report)
// =============================================================================

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model TakeReport {
  id         String       @id @default(cuid())
  takeId     String
  reporterId String
  reason     ReportReason
  details    String?      @db.Text
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  take       Take         @relation(fields: [takeId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([takeId, reporterId])
  @@index([takeId])
  @@index([reporterId])
  @@index([status])
}

// =============================================================================
// NOTIFICATION TRACKING
// =============================================================================

model GameNotificationLog {
  id        String     @id @default(cuid())
  gameId    String
  status    GameStatus
  sentAt    DateTime   @default(now())
  userCount Int        @default(0)

  game      Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, status])
  @@index([sentAt])
}

model NotificationLog {
  id              String           @id @default(cuid())
  type            NotificationType
  title           String
  body            String?
  data            Json?
  targetAudience  String           @default("all")
  totalRecipients Int              @default(0)
  successCount    Int              @default(0)
  failureCount    Int              @default(0)
  sentByUserId    String?
  createdAt       DateTime         @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([sentByUserId])
}

// ─── Weekly KPI Snapshots ────────────────────────────────────────────────────
// One row per Monday-of-week. Tracks DAU, retention, sessions, ARPDAU,
// rating, crash rate against 2026 casual-mobile-game industry benchmarks.
// Populated manually via /admin/weekly-kpis or auto-fetched from Google
// Analytics 4 via the fetch endpoint.
model WeeklyKpiSnapshot {
  id             String   @id @default(cuid())
  weekOf         DateTime @unique @map("week_of") // Monday date for this week
  dau            Int
  d1Retention    Float    @map("d1_retention")
  d7Retention    Float    @map("d7_retention")
  d30Retention   Float    @map("d30_retention")
  sessionsPerDau Float    @map("sessions_per_dau")
  avgSessionSecs Int      @map("avg_session_secs")
  arpdau         Float
  rating         Float
  crashRate      Float    @map("crash_rate")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("weekly_kpi_snapshots")
}

// ─── Stat Lab: Saved natural-language queries ────────────────────────────────
// Users save queries from Ask the Lab. A cron evaluates them periodically and
// fires a push notification when the saved query produces a new result.
model SavedLabQuery {
  id            String   @id @default(cuid())
  userId        String
  rawQuery      String   @db.Text
  parsed        Json
  label         String?  // Optional user-given label
  lastRunAt     DateTime?
  lastResultIds String[] // game/stat IDs from the last evaluation
  notifyOnNew   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastRunAt])
}

// ─── Take Cards: track virality ──────────────────────────────────────────────
// One row per generated card. Used to surface trending takes and measure share
// flywheel performance.
model ShareCard {
  id           String   @id @default(cuid())
  userId       String?
  template     String   // 'stat-line' | 'comparison' | 'hot-take' | 'quote' | 'ranking'
  theme        String   // 'light' | 'dark' | 'orange'
  payload      Json     // The raw card data so we can re-render
  sourceUrl    String?  // Deep link back into the app
  shareCount   Int      @default(0)
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([template])
  @@index([createdAt])
}
